{
  "name": "market-intelligence-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "cli": "pnpm --filter @nemesis-oss/market-research cli",
    "live-study": "pnpm --filter @nemesis-oss/market-research live-study",
    "research": "pnpm --filter @nemesis-oss/market-research-agent cli",
    "tui": "pnpm --filter @nemesis-oss/demo-runner tui",
    "api": "pnpm --filter @nemesis-oss/market-intelligence-api start:dev",
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo || true"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  }
}
