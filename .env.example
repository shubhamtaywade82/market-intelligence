# market-intelligence API — environment configuration
# Copy to .env and adjust. All values are optional with sane defaults.

# --- HTTP server -----------------------------------------------------------
# Listen port and bind address.
PORT=8080
HOST=0.0.0.0

# CORS: '*' to allow any origin (public read-only data), or a comma-separated
# allowlist, e.g. 'https://app.example.com,https://dashboard.example.com'.
CORS_ORIGIN=*

# --- Rate limiting (per client IP) ------------------------------------------
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# --- Market stream ----------------------------------------------------------
# simulated: synthetic candle generator — no exchange connectivity needed.
# live:      real exchange WebSocket (requires adapter wiring in main.ts).
DATA_MODE=simulated

# Comma-separated symbols and timeframes to track.
MARKET_SYMBOLS=ETHUSDT,BTCUSDT
MARKET_TIMEFRAMES=15m

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error — emitted as single-line JSON to stdout.
LOG_LEVEL=info
